---
import ImageMod from "@/components/ImageMod.astro";
import Base from "@/layouts/Base.astro";
import { getListPage } from "@/lib/contentParser.astro";
import { markdownify } from "@/lib/utils/textConverter";
import CheckIcon from "@/components/CheckIcon";
import FeatureIcon from "@/components/FeatureIcon";
import config from "@/config/config.json";
import AnimatedSection from "@/components/animations/AnimatedSection";

const homepage = await getListPage("homepage", "-index");

const { banner, features } = homepage.data;
const { logo, logo_darkmode, title } = config.site;
const { theme_switcher } = config.settings;

// Map feature icons by index
const iconMap: ("rocket" | "planet" | "telescope")[] = ["rocket", "planet", "telescope"];
---

<Base>
  <!-- Banner -->
  <section class="section pt-14">
    <div class="container">
      <div class="row justify-center">
        <div class="lg:col-7 md:col-9 mb-8 text-center">
          <!-- Logo with entrance animation -->
          <AnimatedSection client:load direction="up" delay={0} className="mb-8 flex justify-center">
            <a href="/" class="inline-block">
              {
                logo && (
                  <ImageMod
                    src={logo}
                    class={`inline-block ${theme_switcher && "dark:hidden"}`}
                    width={240}
                    height={240}
                    alt={title}
                    style={{
                      height: "120px",
                      width: "120px",
                    }}
                    format="webp"
                  />
                )
              }
              {
                theme_switcher && logo_darkmode && (
                  <ImageMod
                    src={logo_darkmode}
                    class="hidden dark:inline-block"
                    width={240}
                    height={240}
                    alt={title}
                    style={{
                      height: "120px",
                      width: "120px",
                    }}
                    format="webp"
                  />
                )
              }
            </a>
          </AnimatedSection>

          <!-- Title with delayed entrance -->
          <AnimatedSection client:load direction="up" delay={0.15}>
            <h1
              set:html={markdownify(banner.title)}
              class="mb-4 text-h3 lg:text-h1"
            />
          </AnimatedSection>

          <!-- Content with further delay -->
          <AnimatedSection client:load direction="up" delay={0.3}>
            <p set:html={markdownify(banner.content)} class="mb-8" />
          </AnimatedSection>

          <!-- Button with final delay -->
          {
            banner.button.enable && (
              <AnimatedSection client:load direction="up" delay={0.45}>
                <a
                  class="btn btn-primary"
                  href={banner.button.link}
                  target={
                    banner.button.link.startsWith("http") ? "_blank" : "_self"
                  }
                  rel="noopener"
                >
                  {banner.button.label}
                </a>
              </AnimatedSection>
            )
          }
        </div>

        <!-- Banner image with scroll animation -->
        {
          banner.image && (
            <div class="col-12">
              <AnimatedSection client:visible direction="up" delay={0.5} duration={0.7}>
                <ImageMod
                  src={banner.image}
                  height={533}
                  width={1200}
                  alt="banner"
                  format="webp"
                />
              </AnimatedSection>
            </div>
          )
        }
      </div>
    </div>
  </section>
  <!-- /Banner -->

  <!-- Features with scroll-triggered animations -->
  {
    features.map((feature, index: number) => (
      <section class={`section-sm ${index % 2 === 0 && "bg-gradient"}`}>
        <div class="container">
          <div class="row items-center justify-between">
            <div
              class={`mb:md-0 mb-6 md:col-5 flex justify-center items-center ${index % 2 !== 0 && "md:order-2"}`}
            >
              <AnimatedSection
                client:visible
                direction={index % 2 === 0 ? "left" : "right"}
                delay={0}
              >
                <FeatureIcon
                  client:load
                  type={iconMap[index]}
                  className="w-48 h-48 text-black dark:text-white"
                />
              </AnimatedSection>
            </div>
            <div class={`md:col-7 lg:col-6 ${index % 2 !== 0 && "md:order-1"}`}>
              <AnimatedSection client:visible direction="up" delay={0.15}>
                <h2 set:html={markdownify(feature.title)} class="mb-4" />
                <p set:html={markdownify(feature.content)} class="mb-8 text-lg" />
              </AnimatedSection>

              <ul>
                {feature.bulletpoints.map((bullet: string, bulletIndex: number) => (
                  <AnimatedSection
                    client:visible
                    direction="left"
                    delay={0.3 + bulletIndex * 0.08}
                  >
                    <li class="relative mb-4 pl-6">
                      <CheckIcon client:load className="absolute left-0 top-1.5" />
                      <span set:html={markdownify(bullet)} />
                    </li>
                  </AnimatedSection>
                ))}
              </ul>

              {feature.button.enable && (
                <AnimatedSection client:visible direction="up" delay={0.5}>
                  <a class="btn btn-primary mt-5" href={feature.button.link}>
                    {feature.button.label}
                  </a>
                </AnimatedSection>
              )}
            </div>
          </div>
        </div>
      </section>
    ))
  }
  <!-- /Features -->

  <!-- Lead Form -->
  <section id="lead-form" class="section-sm bg-gradient">
    <div class="container">
      <div class="row justify-center">
        <div class="mx-auto md:col-10 lg:col-7">
          <AnimatedSection client:visible direction="up" delay={0} className="mb-10 text-center">
            <h2 class="mb-4">Get in Touch</h2>
            <p class="text-lg">
              Fill out the form below and one of our local agents will reach out
              with personalized options.
            </p>
          </AnimatedSection>

          <AnimatedSection client:visible direction="up" delay={0.15}>
            <form id="lead-form-form" method="POST" action="#">
              <div class="row">
                <div class="mb-6 md:col-6">
                  <label for="first_name" class="form-label">
                    First Name <span class="text-red-500">*</span>
                  </label>
                  <input
                    id="first_name"
                    name="first_name"
                    class="form-input"
                    placeholder="First Name"
                    type="text"
                    required
                  />
                </div>
                <div class="mb-6 md:col-6">
                  <label for="last_name" class="form-label">
                    Last Name <span class="text-red-500">*</span>
                  </label>
                  <input
                    id="last_name"
                    name="last_name"
                    class="form-input"
                    placeholder="Last Name"
                    type="text"
                    required
                  />
                </div>
                <div class="mb-6 md:col-6">
                  <label for="phone" class="form-label">
                    Phone <span class="text-red-500">*</span>
                  </label>
                  <input
                    id="phone"
                    name="phone"
                    class="form-input"
                    placeholder="(555) 555-5555"
                    type="tel"
                    required
                  />
                </div>
                <div class="mb-6 md:col-6">
                  <label for="email" class="form-label">
                    Email <span class="text-red-500">*</span>
                  </label>
                  <input
                    id="email"
                    name="email"
                    class="form-input"
                    placeholder="you@example.com"
                    type="email"
                    required
                  />
                </div>
                <div class="mb-6 col-12">
                  <label for="street_address" class="form-label">
                    Street Address <span class="text-red-500">*</span>
                  </label>
                  <input
                    id="street_address"
                    name="street_address"
                    class="form-input"
                    placeholder="123 Main St"
                    type="text"
                    required
                  />
                </div>
                <div class="mb-6 md:col-6">
                  <label for="city" class="form-label">
                    City <span class="text-red-500">*</span>
                  </label>
                  <input
                    id="city"
                    name="city"
                    class="form-input"
                    placeholder="City"
                    type="text"
                    required
                  />
                </div>
                <div class="mb-6 md:col-2">
                  <label for="state" class="form-label">
                    State <span class="text-red-500">*</span>
                  </label>
                  <input
                    id="state"
                    name="state"
                    class="form-input"
                    placeholder="CA"
                    type="text"
                    required
                  />
                </div>
                <div class="mb-6 md:col-4">
                  <label for="zip" class="form-label">
                    ZIP Code <span class="text-red-500">*</span>
                  </label>
                  <input
                    id="zip"
                    name="zip"
                    class="form-input"
                    placeholder="12345"
                    type="text"
                    inputmode="numeric"
                    required
                  />
                </div>
                <div class="mb-6 col-12">
                  <label for="coverage_type" class="form-label">
                    Coverage Type <span class="text-red-500">*</span>
                  </label>
                  <select
                    id="coverage_type"
                    name="coverage_type"
                    class="form-input"
                    required
                  >
                    <option value="" disabled selected>Select coverage type</option>
                    <option value="auto">Auto</option>
                    <option value="home">Home</option>
                    <option value="auto_and_home">Auto and Home</option>
                  </select>
                </div>
              </div>

              <div class="mt-2 mb-8 space-y-5">
                <label class="flex cursor-pointer items-start gap-3" for="consent_tcpa">
                  <input
                    id="consent_tcpa"
                    name="consent_tcpa"
                    type="checkbox"
                    class="mt-1 h-5 w-5 shrink-0 rounded border-2 border-gray-300 text-primary focus:ring-primary"
                    required
                  />
                  <span class="text-sm text-text dark:text-darkmode-text">
                    By checking this box and clicking SUBMIT, I express my
                    understanding and consent electronically via E-sign that I
                    acknowledge, agree and consent to the <a
                      href="/privacy-policy"
                      class="text-primary underline">Privacy Policy</a
                    >, which includes binding arbitration, and I am providing
                    express written consent for Policy Liaison to contact me by
                    phone calls at the phone number provided regarding scheduling
                    and application status using any telephone dialing system,
                    prerecorded/artificial voice messages, and/or an automatic
                    telephone dialing system (as applicable), even if my telephone
                    number is currently listed on any state or federal Do-Not-Call
                    list. I may revoke this consent at any time and I am not
                    required to opt in as a condition of these services.
                  </span>
                </label>

                <label class="flex cursor-pointer items-start gap-3" for="consent_sms">
                  <input
                    id="consent_sms"
                    name="consent_sms"
                    type="checkbox"
                    class="mt-1 h-5 w-5 shrink-0 rounded border-2 border-gray-300 text-primary focus:ring-primary"
                    required
                  />
                  <span class="text-sm text-text dark:text-darkmode-text">
                    By checking this box, I consent to receive marketing SMS
                    notifications and alerts from Policy Liaison. This SMS Opt-in
                    consent will not be shared. No Mobile information will be shared
                    with third parties for marketing purposes. Message frequency
                    may vary. Message and data rates may apply. Reply HELP for Help.
                    You can also reply STOP to unsubscribe at any time.
                    <a
                      href="/privacy-policy"
                      class="text-primary underline">Privacy Policy</a
                    >
                  </span>
                </label>

                <label class="flex cursor-pointer items-start gap-3" for="consent_marketing">
                  <input
                    id="consent_marketing"
                    name="consent_marketing"
                    type="checkbox"
                    class="mt-1 h-5 w-5 shrink-0 rounded border-2 border-gray-300 text-primary focus:ring-primary"
                    required
                  />
                  <span class="text-sm text-text dark:text-darkmode-text">
                    By checking this box, I agree to receive occasional marketing
                    messages from Policy Liaison.
                  </span>
                </label>
              </div>

              <button type="submit" class="btn btn-primary">Submit</button>
            </form>

            <div
              id="lead-form-success"
              class="mt-8 hidden rounded-lg border-2 border-primary bg-light p-8 text-center dark:bg-darkmode-light"
              role="status"
              aria-live="polite"
            >
              <h3 class="mb-2">Thank you!</h3>
              <p class="mb-6 text-lg">
                Your request has been received. One of our local agents will
                reach out to you shortly with personalized options.
              </p>
              <button id="lead-form-again" type="button" class="btn btn-primary">
                Submit Another Form
              </button>
            </div>
          </AnimatedSection>
        </div>
      </div>
    </div>
  </section>
  <!-- /Lead Form -->

  <script>
    const leadForm = document.getElementById(
      "lead-form-form",
    ) as HTMLFormElement | null;
    const leadFormSuccess = document.getElementById("lead-form-success");
    const leadFormAgain = document.getElementById("lead-form-again");

    leadForm?.addEventListener("submit", (event) => {
      event.preventDefault();

      // Let the browser enforce the required fields and checkboxes.
      if (!leadForm.checkValidity()) {
        leadForm.reportValidity();
        return;
      }

      leadForm.classList.add("hidden");
      leadFormSuccess?.classList.remove("hidden");
      leadForm.reset();
      leadFormSuccess?.scrollIntoView({ behavior: "smooth", block: "center" });
    });

    leadFormAgain?.addEventListener("click", () => {
      leadFormSuccess?.classList.add("hidden");
      leadForm?.classList.remove("hidden");
      leadForm?.scrollIntoView({ behavior: "smooth", block: "center" });
    });
  </script>
</Base>
