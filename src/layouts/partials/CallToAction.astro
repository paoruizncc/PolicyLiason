---
import ImageMod from "@/components/ImageMod.astro";
import { markdownify } from "@/lib/utils/textConverter";
import AnimatedSection from "@/components/animations/AnimatedSection";
import { AnimatedCTAButton } from "@/components/animations/AnimatedCTA";
const { call_to_action } = Astro.props;
---

{
  call_to_action.data.enable && (
    <section class="mb-28">
      <div class="container">
        <AnimatedSection client:visible direction="up" delay={0} duration={0.6}>
          <div class="rounded-xl bg-light px-4 py-16 dark:bg-darkmode-light xl:p-20">
            <div class="row items-center justify-between">
              <div class="mb-10 md:col-5 lg:col-4 md:order-2 md:mb-0">
                <AnimatedSection client:visible direction="right" delay={0.2}>
                  <ImageMod
                    class="w-full"
                    src={call_to_action.data.image}
                    width={392}
                    height={390}
                    alt="cta-image"
                    format="webp"
                  />
                </AnimatedSection>
              </div>
              <div class="md:col-7 md:order-1">
                <AnimatedSection client:visible direction="up" delay={0.3}>
                  <h2
                    set:html={markdownify(call_to_action.data.title)}
                    class="mb-2"
                  />
                  <p
                    set:html={markdownify(call_to_action.data.description)}
                    class="mb-6"
                  />
                  {call_to_action.data.button.enable && (
                    <AnimatedCTAButton
                      client:visible
                      href={call_to_action.data.button.link}
                      className="btn btn-primary"
                    >
                      {call_to_action.data.button.label}
                    </AnimatedCTAButton>
                  )}
                </AnimatedSection>
              </div>
            </div>
          </div>
        </AnimatedSection>
      </div>
    </section>
  )
}
